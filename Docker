# 1. Start with an official Python home base
FROM python:3.11-slim

# 2. Set the working folder inside the container
WORKDIR /app

# 3. Copy our requirements file and install the libraries
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 4. Copy the rest of our python code files
COPY . .

# 5. Tell the container to start our API server automatically
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
